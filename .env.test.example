# ==============================================================================
# LumeraX E2E Test & Telemetry Environment Configuration Template
# ==============================================================================
# Copy this file to .env.test for local runs:
#   cp .env.test.example .env.test
#
# NOTE: .env.test is strictly ignored by git to prevent secret leakage.
# ==============================================================================

# Stremio Test Account Credentials
STREMIO_TEST_EMAIL=brunogrti@gmail.com
STREMIO_TEST_PASSWORD=banana-com-cafe-eu-gosto

# Secondary Partition Storage Base (Isolates SDK, AVD, and Gradle from root /)
STEAM_ANDROID_BASE=/media/bruno/SteamGames/android

# Android AVD Configuration
AVD_NAME=lumerax_e2e_tv
EMULATOR_GPU_MODE=swiftshader_indirect

# E2E Test & Telemetry Parameters
PLAYBACK_DURATION_SECONDS=10
MAX_SOURCES_PER_CATEGORY=5
ADB_TIMEOUT_SECONDS=60

# Target Package & Activity
APP_PACKAGE=com.lumera.app
MAIN_ACTIVITY=.MainActivity

# Output Directory for Artifacts & Telemetry Reports
TEST_RESULTS_DIR=test-results
